generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EstadoGeneral {
  ACTIVO
  INACTIVO
}

enum EstadoLote {
  Disponible
  Reservado
  Vendido
}

enum SexoPersona {
  M
  F
}

enum EstadoCivil {
  SOLTERO
  CASADO
  CONVIVIENTE
  DIVORCIADO
}

enum TipoTelefono {
  PERSONAL
  TRABAJO
  WHATSAPP
}

enum CanalContacto {
  WHATSAPP
  WEB
}

enum TipoRemitente {
  BOT
  HUMANO
}

enum EstadoCita {
  PROGRAMADA
  ATENDIDA
  CANCELADA
}

enum TipoPago {
  CONTADO
  CREDITO
}

enum EstadoVenta {
  FINALIZADA
  PENDIENTE
  ANULADO
}

enum SolvenciaEconomica {
  DESCARTADO
  MOROSO
  PAGA_ATRASADO @map("PAGA ATRASADO")
  BUEN_PAGADOR
  EXCELENTE
}

enum ActitudCliente {
  QUEJOSO
  ENOJADO
  DESCONFIADO
  AMABLE
}

enum EstadoCuota {
  PENDIENTE
  PAGADO
}

enum EstadoContrato {
  ADENDA
  POR_RESOLVER       @map("POR RESOLVER")
  ESCRITURA_PUBLICA  @map("ESCRITURA PUBLICA")
  CESION_CONTRACTUAL @map("CESION CONTRACTUAL")
  FIRMADO
}

enum MetodoPago {
  EFECTIVO
  TRANSFERENCIA
  DEPOSITO
}

enum EstadoChat {
  BOT
  ESPERANDO_ASESOR @map("ESPERANDO_ASESOR")
  ATENDIDO_HUMANO  @map("ATENDIDO_HUMANO")
  FINALIZADO
}

enum EstadoLead {
  NUEVO
  CONTACTADO
  CALIFICADO
  INTERESADO
  CITA_AGENDADA
  NEGOCIACION
  GANADO
  PERDIDO
}

enum EstadoCotizacion {
  BORRADOR
  EMITIDA
  ACEPTADA
  RECHAZADA
  VENCIDA
}

enum TipoEvaluacion {
  CHATBOT
  ASESOR
  CITA
}

enum TipoEventoConversacion {
  INICIADA
  MENSAJE_RECIBIDO
  MENSAGE_ENVIADO
  BOT_RESPONDE
  TRANSFERIDA_A_HUMANO
  ASESOR_ASIGNADO
  CITA_CREADA
  COTIZACION_CREADA
  FINALIZADA
}

enum GeneradoPor {
  BOT
  ASESOR
}

model Ubigeos {
  id        String      @id @db.Char(6)
  nombre    String      @db.VarChar(100)
  proyectos Proyectos[]
  clientes  Clientes[]
  personas  Personas[]

  @@map("ubigeos")
}

model Roles {
  id          Int           @id @default(autoincrement())
  nombre      String        @unique @db.VarChar(50)
  descripcion String?       @db.Text
  estado      EstadoGeneral @default(ACTIVO)
  created_at  DateTime      @default(now())
  usuarios    Usuarios[]

  @@map("roles")
}

model Usuarios {
  id                      String                   @id @default(uuid()) @db.Uuid
  id_rol                  Int
  rol                     Roles                    @relation(fields: [id_rol], references: [id])
  dni                     String                   @db.Char(8)
  nombres                 String                   @db.VarChar(100)
  apellidos               String                   @db.VarChar(100)
  email                   String                   @unique @db.VarChar(100)
  password_hash           String                   @db.VarChar(150)
  telefono                String?                  @db.VarChar(20)
  ultimo_login            DateTime?
  estado                  EstadoGeneral            @default(ACTIVO)
  created_at              DateTime                 @default(now())
  updated_at              DateTime                 @updatedAt
  conversaciones_asig     Conversaciones[]         @relation("AsignacionAsesor")
  mensajes                Mensajes[]
  citas_responsable       Citas[]
  notificaciones          NotificacionesCuota[]
  ventas                  Ventas[]
  conversacionAsignacions ConversacionAsignacion[]
  leads                   Leads[]
  evaluacionesAtencions   EvaluacionesAtencion[]
  eventosConversacions    EventosConversacion[]
  cotizaciones_creadas    Cotizaciones[]           @relation("CotizacionCreador")
  cotizaciones_revision   Cotizaciones[]           @relation("CotizacionRevisor")
  metricasAsesorDiarias   MetricasAsesorDiarias[]

  @@index([id_rol])
  @@map("usuarios")
}

model Proyectos {
  id                   Int            @id @default(autoincrement())
  id_ubigeo            String         @db.Char(6)
  ubigeo               Ubigeos        @relation(fields: [id_ubigeo], references: [id])
  nombre               String         @db.VarChar(100)
  abreviatura          String?        @db.VarChar(20)
  ubicacion            String?        @db.Text
  descripcion          String?        @db.Text
  porcentaje_descuento Decimal?       @default(0) @db.Decimal(5, 2)
  plano_url            String?        @db.VarChar(255)
  estado               EstadoGeneral?
  created_at           DateTime       @default(now())
  updated_at           DateTime       @updatedAt
  etapas               Etapas[]
  citas                Citas[]
  leads                Leads[]

  @@index([id_ubigeo])
  @@map("proyectos")
}

model Etapas {
  id          Int            @id @default(autoincrement())
  id_proyecto Int
  proyecto    Proyectos      @relation(fields: [id_proyecto], references: [id])
  nombre      String         @db.VarChar(50)
  estado      EstadoGeneral?
  created_at  DateTime       @default(now())
  manzanas    Manzanas[]

  @@index([id_proyecto])
  @@map("etapas")
}

model Manzanas {
  id         Int            @id @default(autoincrement())
  id_etapa   Int
  etapa      Etapas         @relation(fields: [id_etapa], references: [id])
  codigo     String         @db.VarChar(10)
  estado     EstadoGeneral?
  created_at DateTime       @default(now())
  lotes      Lotes[]

  @@index([id_etapa])
  @@map("manzanas")
}

model Lotes {
  id                    Int             @id @default(autoincrement())
  id_manzana            Int
  manzana               Manzanas        @relation(fields: [id_manzana], references: [id])
  numero_lote           String          @db.VarChar(10)
  numero_partida        String?         @db.VarChar(20)
  area_m2               Decimal         @db.Decimal(10, 2)
  precio_m2             Decimal         @db.Decimal(10, 2)
  // Nota: precio_total es calculado en BD. Prisma lo lee pero no lo inserta directamente si es STORED.
  precio_total          Decimal         @default(dbgenerated()) @db.Decimal(12, 2)
  ubicacion_referencial String?         @db.Text
  estado                EstadoLote?
  created_at            DateTime        @default(now())
  updated_at            DateTime        @updatedAt
  imagenes              LotesImagenes[]
  citas                 Citas[]
  ventas                Ventas[]
  cotizaciones          Cotizaciones[]

  @@index([id_manzana])
  @@map("lotes")
}

model LotesImagenes {
  id           Int     @id @default(autoincrement())
  id_lote      Int
  lote         Lotes   @relation(fields: [id_lote], references: [id], onDelete: Cascade)
  url_imagen   String  @db.VarChar(255)
  descripcion  String? @db.VarChar(100)
  es_principal Boolean @default(false)

  @@index([id_lote])
  @@map("lotes_imagenes")
}

model TipoDocIdentidad {
  id       Int            @id @default(autoincrement())
  codigo   String         @db.VarChar(2)
  nombre   String         @db.VarChar(100)
  estado   EstadoGeneral?
  clientes Clientes[]
  personas Personas[]

  @@map("tipo_doc_identidad")
}
model Personas {
  id          Int              @id @default(autoincrement())
  id_tipo_doc Int?
  tipo_doc    TipoDocIdentidad? @relation(fields: [id_tipo_doc], references: [id])

  id_ubigeo String?  @db.Char(6)
  ubigeo    Ubigeos? @relation(fields: [id_ubigeo], references: [id])

  numero           String?       @db.VarChar(12)
  nombres          String?      @db.VarChar(50)
  apellidos        String?      @db.VarChar(50)
  fecha_nacimiento DateTime?    @db.Date
  sexo             SexoPersona?
  estado_civil     EstadoCivil?

  es_peruano   Boolean @default(true)
  nacionalidad String? @db.VarChar(30)
  direccion    String? @db.VarChar(255)
  email        String? @db.VarChar(100)
  ocupacion    String? @db.VarChar(150)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  telefonos             TelefonosPersona[]
  leads                 Leads[]
  cliente               Clientes?
  conversaciones        Conversaciones[]
  citas                 Citas[]
  cotizaciones          Cotizaciones[]
  evaluacionesAtencions EvaluacionesAtencion[]

  @@unique([id_tipo_doc, numero])
  @@index([id_ubigeo])
  @@map("personas")
}

model Leads {
  id             Int        @id @default(autoincrement())
  id_persona     Int
  persona        Personas   @relation(fields: [id_persona], references: [id])
  id_asesor      String?    @db.Uuid
  asesor         Usuarios?  @relation(fields: [id_asesor], references: [id])
  id_proyecto    Int?
  proyecto       Proyectos? @relation(fields: [id_proyecto], references: [id])
  estado         EstadoLead @default(NUEVO)
  origen         String?    @db.VarChar(50)
  motivo_perdida String?    @db.VarChar(255)

  fecha_contacto      DateTime?
  fecha_calificacion DateTime?
  fecha_cierre       DateTime?

  created_at     DateTime         @default(now())
  updated_at     DateTime         @updatedAt
  conversaciones Conversaciones[]
  citas          Citas[]
  cotizaciones   Cotizaciones[]
  ventas         Ventas[]

  @@index([id_persona])
  @@index([id_asesor])
  @@index([id_proyecto])
  @@index([estado])
  @@map("leads")
}

model Clientes {
  id                    Int                    @id @default(autoincrement())
  id_persona            Int                    @unique
  persona               Personas               @relation(fields: [id_persona], references: [id])
  solvencia             SolvenciaEconomica?
  actitud               ActitudCliente?
  created_at            DateTime               @default(now())
  updated_at            DateTime               @updatedAt
  conversaciones        Conversaciones[]
  citas                 Citas[]
  ventas                Ventas[]
  ubigeos               Ubigeos?               @relation(fields: [ubigeosId], references: [id])
  ubigeosId             String?                @db.Char(6)
  tipoDocIdentidad      TipoDocIdentidad?      @relation(fields: [tipoDocIdentidadId], references: [id])
  tipoDocIdentidadId    Int?
  cotizaciones          Cotizaciones[]
  evaluacionesAtencions EvaluacionesAtencion[]

  @@map("clientes")
}

model TelefonosPersona {
  id         Int           @id @default(autoincrement())
  id_persona Int
  persona    Personas      @relation(fields: [id_persona], references: [id])
  numero     String?       @unique @db.VarChar(20)
  tipo       TipoTelefono?

  @@index([id_persona])
  @@map("telefonos_persona")
}

model Conversaciones {
  id                             String                   @id @default(uuid()) @db.Uuid

  id_persona                     Int?
  persona                        Personas?                 @relation(fields: [id_persona], references: [id])
  id_lead                        Int?
  lead                           Leads?                   @relation(fields: [id_lead], references: [id])

  session_id                     String?                  @unique @db.VarChar(100)
  canal                          CanalContacto?
  estado                         EstadoChat               @default(BOT)

  id_usuario_asignado            String?                  @db.Uuid
  asesor                         Usuarios?                @relation("AsignacionAsesor", fields: [id_usuario_asignado], references: [id])

  fecha_primer_mensaje           DateTime?
  fecha_primera_respuesta_bot        DateTime?
  fecha_transferencia            DateTime?
  fecha_asignacion               DateTime?
  fecha_primera_respuesta_humana DateTime?
  fecha_finalizacion             DateTime?

  created_at                     DateTime                 @default(now())
  updated_at                     DateTime                 @updatedAt
  mensajes                       Mensajes[]
  conversacionAsignacions        ConversacionAsignacion[]
  evaluacionesAtencions          EvaluacionesAtencion[]
  eventosConversacions           EventosConversacion[]
  clientes                       Clientes?                @relation(fields: [clientesId], references: [id])
  clientesId                     Int?

  @@index([id_persona])
  @@index([id_lead])
  @@index([id_usuario_asignado])
  @@map("conversaciones")
}

model ConversacionAsignacion {
  id              Int            @id @default(autoincrement())
  id_conversacion String         @db.Uuid
  conversacion    Conversaciones @relation(fields: [id_conversacion], references: [id])
  id_usuario      String         @db.Uuid
  usuario         Usuarios       @relation(fields: [id_usuario], references: [id])
  fecha_inicio    DateTime       @default(now())
  fecha_fin       DateTime

  motivo String? @db.VarChar(100)

  @@index([id_conversacion])
  @@index([id_usuario])
  @@map("conversacion_asignacion")
}

model EventosConversacion {
  id              Int                    @id @default(autoincrement())
  id_conversacion String                 @db.Uuid
  conversacion    Conversaciones         @relation(fields: [id_conversacion], references: [id])
  tipo            TipoEventoConversacion
  id_usuario      String?                @db.Uuid
  usuario         Usuarios?              @relation(fields: [id_usuario], references: [id])
  metadata        Json?
  created_at      DateTime               @default(now())

  @@index([id_conversacion])
  @@index([tipo])
  @@index([created_at])
  @@map("eventos_conversacion")
}

model Mensajes {
  id              Int            @id @default(autoincrement())
  id_usuario      String?        @db.Uuid
  usuario         Usuarios?      @relation(fields: [id_usuario], references: [id])
  id_conversacion String         @db.Uuid
  conversacion    Conversaciones @relation(fields: [id_conversacion], references: [id])
  remitente       TipoRemitente?
  contenido       String?        @db.Text
  created_at      DateTime       @default(now())

  @@index([id_usuario])
  @@map("mensajes")
}

model Citas {
  id                     Int         @id @default(autoincrement())
  id_persona             Int
  persona                Personas    @relation(fields: [id_persona], references: [id])
  id_lead                Int?
  lead                   Leads?      @relation(fields: [id_lead], references: [id])
  id_proyecto            Int
  proyecto               Proyectos   @relation(fields: [id_proyecto], references: [id])
  id_lote                Int?
  lote                   Lotes?      @relation(fields: [id_lote], references: [id])
  id_usuario_responsable String      @db.Uuid
  asesor                 Usuarios    @relation(fields: [id_usuario_responsable], references: [id])
  fecha_cita             DateTime    @db.Date
  hora_cita              DateTime?   @db.Time
  observaciones_visita   String?     @db.Text
  puntuacion_cliente     Int?
  estado_cita            EstadoCita?
  created_at             DateTime    @default(now())
  updated_at             DateTime    @updatedAt
  clientes               Clientes?   @relation(fields: [clientesId], references: [id])
  clientesId             Int?

  @@index([id_persona])
  @@index([id_lead])
  @@index([id_proyecto])
  @@index([id_lote])
  @@map("citas")
}

model Ventas {
  id      Int   @id @default(autoincrement())
  id_lote Int
  lote    Lotes @relation(fields: [id_lote], references: [id])

  id_cliente Int
  cliente    Clientes @relation(fields: [id_cliente], references: [id])
  id_lead    Int?
  lead       Leads?   @relation(fields: [id_lead], references: [id])

  id_asesor String   @db.Uuid
  asesor    Usuarios @relation(fields: [id_asesor], references: [id])

  id_cotizacion Int?
  cotizacion    Cotizaciones? @relation(fields: [id_cotizacion], references: [id])

  fecha_venta     DateTime?       @default(now()) @db.Date
  monto_total     Decimal         @db.Decimal(12, 2)
  cuota_inicial   Decimal?        @default(0) @db.Decimal(12, 2)
  tipo_pago       TipoPago?
  num_cuotas      Int?
  monto_cuota     Decimal?        @db.Decimal(12, 2)
  tasa_interes    Decimal?        @db.Decimal(5, 2)
  dia_pago        Int?
  meses_gracia    Int?            @default(0)
  estado          EstadoVenta?
  estado_contrato EstadoContrato?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  cuotas Cuotas[]

  @@index([id_lote])
  @@index([id_cliente])
  @@map("ventas")
}

model Cuotas {
  id                Int                   @id @default(autoincrement())
  id_venta          Int
  venta             Ventas                @relation(fields: [id_venta], references: [id])
  numero_cuota      Int
  monto_cuota       Decimal               @db.Decimal(12, 2)
  fecha_vencimiento DateTime              @db.Date
  fecha_pago        DateTime?
  estado            EstadoCuota?          @default(PENDIENTE)
  metodo_pago       MetodoPago?
  comprobante_url   String?               @db.VarChar(150)
  created_at        DateTime              @default(now())
  updated_at        DateTime              @updatedAt
  notificaciones    NotificacionesCuota[]

  @@index([id_venta])
  @@map("cuotas")
}

model NotificacionesCuota {
  id               Int       @id @default(autoincrement())
  id_cuota         Int
  cuota            Cuotas    @relation(fields: [id_cuota], references: [id])
  id_usuario       String?   @db.Uuid
  usuario          Usuarios? @relation(fields: [id_usuario], references: [id])
  template         String    @db.VarChar(100)
  telefono_destino String    @db.VarChar(20)
  nivel_urgencia   String?   @db.VarChar(20)
  es_automatica    Boolean   @default(true)
  fecha_envio      DateTime  @default(now())

  @@index([id_cuota])
  @@index([id_usuario])
  @@map("notificaciones_cuota")
}

model Cotizaciones {
  id     Int    @id @default(autoincrement())
  codigo String @unique @db.VarChar(30)

  id_persona Int
  persona    Personas @relation(fields: [id_persona], references: [id])
  id_lead    Int?
  lead       Leads?   @relation(fields: [id_lead], references: [id])

  id_lote Int
  lote    Lotes @relation(fields: [id_lote], references: [id])

  generado_por GeneradoPor @default(BOT)
  id_asesor    String?     @db.Uuid
  asesor       Usuarios?   @relation("CotizacionCreador", fields: [id_asesor], references: [id])

  requiere_revision Boolean   @default(false)
  id_revisor        String?   @db.Uuid
  revisor           Usuarios? @relation("CotizacionRevisor", fields: [id_revisor], references: [id])
  fecha_revision    DateTime?

  area_m2      Decimal @db.Decimal(12, 2)
  precio_m2    Decimal @db.Decimal(12, 2)
  precio_lista Decimal @db.Decimal(12, 2)
  descuento    Decimal @default(0) @db.Decimal(5, 2)
  precio_final Decimal @db.Decimal(12, 2)

  cuota_inicial Decimal? @db.Decimal(12, 2)
  numero_cuotas Int?
  monto_cuota   Decimal? @db.Decimal(12, 2)

  estado EstadoCotizacion @default(BORRADOR)

  pdf_url    String?   @db.VarChar(255)
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  ventas     Ventas[]
  clientes   Clientes? @relation(fields: [clientesId], references: [id])
  clientesId Int?

  @@index([id_persona])
  @@index([id_lead])
  @@index([id_lote])
  @@index([id_asesor])
  @@map("cotizaciones")
}

model EvaluacionesAtencion {
  id         Int      @id @default(autoincrement())
  id_persona Int
  persona    Personas @relation(fields: [id_persona], references: [id])

  id_conversacion String?         @db.Uuid
  conversacion    Conversaciones? @relation(fields: [id_conversacion], references: [id])

  id_usuario String?   @db.Uuid
  asesor     Usuarios? @relation(fields: [id_usuario], references: [id])

  tipo TipoEvaluacion

  puntuacion       Int
  criterios        Json?
  sentimiento      String? @db.VarChar(100)
  es_automatica    Boolean @default(true)
  id_mensage_desde Int?
  id_mensage_hacia Int?
  comentario       String? @db.Text

  created_at DateTime  @default(now())
  clientes   Clientes? @relation(fields: [clientesId], references: [id])
  clientesId Int?

  @@index([id_persona])
  @@index([id_conversacion])
  @@index([id_usuario])
  @@map("evaluaciones_atencion")
}

model MetricasAsesorDiarias {
  id         Int      @id @default(autoincrement())
  id_usuario String   @db.Uuid
  usuario    Usuarios @relation(fields: [id_usuario], references: [id])
  fecha      DateTime @db.Date

  clientes_atendidos        Int      @default(0)
  tiempo_respuesta_prom_seg Int?
  puntuacion_atencion_prom  Decimal? @db.Decimal(3, 2)

  ventas_cerradas Int     @default(0)
  monto_vendido   Decimal @default(0) @db.Decimal(12, 2)

  tasa_cierre_propio Decimal? @db.Decimal(5, 2)

  created_at DateTime @default(now())

  @@unique([id_usuario, fecha])
  @@index([fecha])
  @@map("metricas_asesor_diarias")
}
